      "id": "cf352f65-d17e-435e-a490-7d5690ed58c5",
      "name": "Active Clients",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        300
      ],
      "alwaysOutputData": false
