    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst toDT = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return DateTime.fromMillis(Math.round((v - 25569) * 86400000), { zone: 'utc' });\n  const s = String(v).trim();\n  let d = DateTime.fromISO(s);\n  if (!d.isValid) d = DateTime.fromJSDate(new Date(s));\n  return d.isValid ? d : null;\n};\nconst daysSince = (v) => {\n  const d = toDT(v);\n  return d ? DateTime.now().diff(d, 'days').days : null;\n};\n\nconst cfg = $('Config').first().json;\n\nreturn $input.all().flatMap((item, i) => {\n  const c = item.json;\n  const email = lc(c.email);\n  if (!email || lc(c.status) !== 'active') return [];\n  const age = daysSince(c.start_date);\n  if (age !== null && age < 5) return [];\n  const sinceCheckin = daysSince(c.last_checkin_at);\n  if (sinceCheckin !== null && sinceCheckin < 3) return [];\n\n  const week = age === null ? Number(c.checkins_count || 0) + 1 : Math.max(1, Math.ceil(age / 7));\n  const link = c.checkin_url || `${cfg.checkinFormUrl}?Email=${encodeURIComponent(email)}`;\n  const first = firstName(c.name);\n\n  const body = [\n    `Hi ${first},`,\n    '',\n    `Time for your week ${week} check-in. It takes about three minutes and it is how I adjust your plan for next week:`,\n    '',\n    link,\n    '',\n    'Be honest - a rough week tells me more than a perfect one.',\n    '',\n    cfg.coachName,\n  ].join('\\n');\n\n  return [{ json: { email, subject: `${first}, your week ${week} check-in (3 min)`, body }, pairedItem: { item: i } }];\n});\n"
      },
      "id": "c76b878c-7c26-4470-adce-44ebbe3b462d",
