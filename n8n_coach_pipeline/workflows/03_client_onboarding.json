      "id": "f3dce16e-a721-4a6f-a604-fb414a540c5b",
      "name": "Find Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst claudeRequest = (cfg, system, user, schema, effort) => ({\n  model: cfg.claudeModel,\n  max_tokens: 8000,\n  fallbacks: 'default',\n  system,\n  messages: [{ role: 'user', content: user }],\n  output_config: { effort: effort || 'medium', format: { type: 'json_schema', schema } },\n});\n\nconst cfg = $('Config').first().json;\nconst pay = $('Normalize Payment').first().json;\nconst lead = $input.all().map((i) => i.json).find((r) => lc(r.email) === pay.email) || {};\nconst checkinUrl = `${cfg.checkinFormUrl}?Email=${encodeURIComponent(pay.email)}`;\nconst clearance = lc(lead.medical_clearance) === 'required';\n\nconst system = [\n  `You write onboarding messages for ${cfg.businessName}, where ${cfg.coachName} coaches clients 1:1 online. A new client has just paid for \"${pay.plan}\".`,\n  '',\n  'Write three things.',\n  '',\n  'email_subject and email_body: the welcome email.',\n  `- Plain text, under 220 words, greet them by first name, sign off as ${cfg.coachName}.`,\n  '- One genuine line about their goal, using what they told us.',\n  '- What happens next: within 48 hours the coach reviews their details and sends their first training week.',\n  `- Every Sunday they get a three-minute check-in form (${checkinUrl}); it is how the plan gets adjusted, so it matters.`,\n  '- A short numbered list with the three week-one focuses from week_one_focus.',\n  '- One small action for today tied to their goal, for example a 20-minute walk or baseline photos and measurements.',\n  '- If medical clearance is required, kindly ask them to confirm their doctor is happy for them to start exercising before the first session. Keep it calm and matter-of-fact.',\n  '',\n  'week_one_focus: three short habit or training focuses for week one, matched to their experience level. No calorie targets, no supplements, no medical claims.',\n  '',\n  'coach_kickoff_notes: two or three sentences telling the coach what to prioritise when writing the first programme, including any health flags.',\n].join('\\n');\n\nconst user = [\n  'New client:',\n  `Name: ${pay.name || lead.name || '(not given)'}`,\n  `Plan: ${pay.plan}`,\n  `Goal: ${lead.goal || '(no application on file)'}`,\n  `Goal details: ${lead.goal_details || '(not given)'}`,\n  `Experience: ${lead.experience || '(not given)'}`,\n  `Days per week: ${lead.days_per_week || '(not given)'}`,\n  `Health notes: ${lead.health_notes || 'none mentioned'}`,\n  `Health flags: ${lead.health_flags || 'none'}`,\n  `Medical clearance required: ${clearance ? 'yes' : 'no'}`,\n  `Coach summary from the consult: ${lead.ai_summary || '(none)'}`,\n].join('\\n');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['email_subject', 'email_body', 'week_one_focus', 'coach_kickoff_notes'],\n  properties: {\n    email_subject: { type: 'string' },\n    email_body: { type: 'string' },\n    week_one_focus: { type: 'array', items: { type: 'string' } },\n    coach_kickoff_notes: { type: 'string' },\n  },\n};\n\nreturn [{ json: { request: claudeRequest(cfg, system, user, schema, 'medium'), lead, checkin_url: checkinUrl }, pairedItem: { item: 0 } }];\n"
      },
