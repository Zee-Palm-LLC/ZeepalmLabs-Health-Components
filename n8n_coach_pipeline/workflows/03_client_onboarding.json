      "id": "de58abc7-5629-482b-a6e2-7ac118a10bff",
      "name": "Claude: Welcome Pack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst parseClaude = (res) => {\n  if (res.stop_reason === 'refusal') throw new Error('Claude declined this request: ' + JSON.stringify(res.stop_details || {}));\n  if (res.stop_reason === 'max_tokens') throw new Error('Claude ran out of tokens; raise max_tokens in the matching Build node');\n  const block = (res.content || []).find((b) => b.type === 'text');\n  if (!block) throw new Error('Claude returned no text block: ' + JSON.stringify(res).slice(0, 500));\n  return JSON.parse(block.text);\n};\n\nconst pay = $('Normalize Payment').first().json;\nconst ctx = $('Build Welcome Prompt').first().json;\nconst lead = ctx.lead || {};\nconst ai = parseClaude($input.first().json);\nconst name = pay.name || lead.name || '';\n\nconst coachAlert = [\n  `🎉 New client: ${name || pay.email} - ${pay.plan}${pay.amount_paid ? ` (${pay.amount_paid} ${pay.currency})` : ''}`,\n  lead.email ? `Goal: ${lead.goal || '?'} | Experience: ${lead.experience || '?'}` : 'No application on file - paid directly.',\n  lc(lead.medical_clearance) === 'required' ? `⚠️ Medical clearance required: ${lead.health_flags || 'see application'}` : '',\n  '',\n  `Kickoff notes: ${ai.coach_kickoff_notes}`,\n  '',\n  'Week one focus:',\n  ...(ai.week_one_focus || []).map((f, i) => `${i + 1}. ${f}`),\n  '',\n  'Welcome email sent. First programme due within 48 hours.',\n].join('\\n').replace(/\\n{3,}/g, '\\n\\n');\n\nreturn [\n  {\n    json: {\n      client_id: 'C-' + Date.now().toString(36).toUpperCase(),\n      email: pay.email,\n      name,\n      start_date: DateTime.now().toISODate(),\n      plan: pay.plan,\n      status: 'active',\n      goal: lead.goal || '',\n      medical_clearance: lead.medical_clearance || 'not flagged',\n      checkin_url: ctx.checkin_url,\n      last_checkin_at: '',\n      last_adherence: '',\n      risk_level: 'new',\n      checkins_count: 0,\n      amount_paid: pay.amount_paid,\n      currency: pay.currency,\n      stripe_customer: pay.stripe_customer,\n      lead_id: lead.lead_id || 'L-' + Date.now().toString(36).toUpperCase(),\n      email_subject: ai.email_subject,\n      email_body: ai.email_body,\n      coach_alert: coachAlert,\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
