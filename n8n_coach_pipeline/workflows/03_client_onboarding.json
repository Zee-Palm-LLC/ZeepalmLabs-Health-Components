    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\n\nreturn $input.all().map((item, i) => {\n  const s = (item.json.data && item.json.data.object) || {};\n  const details = s.customer_details || {};\n  const email = String(details.email || s.customer_email || '').trim().toLowerCase();\n  if (!email) throw new Error('Stripe checkout session has no customer email');\n  return {\n    json: {\n      email,\n      name: details.name || '',\n      plan: (s.metadata && s.metadata.plan) || cfg.programName,\n      amount_paid: s.amount_total != null ? (s.amount_total / 100).toFixed(2) : '',\n      currency: String(s.currency || '').toUpperCase(),\n      stripe_customer: s.customer || '',\n      session_id: s.id || '',\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      },
      "id": "b77fab9e-1997-4ea1-a253-26c174bd3ec3",
      "name": "Normalize Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
