      "id": "4f487a8b-4418-431f-a66d-8ca29f265a22",
      "name": "Claude: Write Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parseClaude = (res) => {\n  if (res.stop_reason === 'refusal') throw new Error('Claude declined this request: ' + JSON.stringify(res.stop_details || {}));\n  if (res.stop_reason === 'max_tokens') throw new Error('Claude ran out of tokens; raise max_tokens in the matching Build node');\n  const block = (res.content || []).find((b) => b.type === 'text');\n  if (!block) throw new Error('Claude returned no text block: ' + JSON.stringify(res).slice(0, 500));\n  return JSON.parse(block.text);\n};\n\nconst { lead, step } = $('Pick Follow-ups').item.json;\nconst ai = parseClaude($json);\n\nreturn {\n  json: {\n    email: lead.email,\n    subject: ai.subject,\n    body: `${ai.body}\\n\\n(Not interested? Reply \"stop\" and I will not email you again.)`,\n    followups_sent: step,\n    last_contact_at: new Date().toISOString(),\n    status: step >= 3 ? 'nurture_done' : lead.status,\n  },\n};\n"
      },
