    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst toDT = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return DateTime.fromMillis(Math.round((v - 25569) * 86400000), { zone: 'utc' });\n  const s = String(v).trim();\n  let d = DateTime.fromISO(s);\n  if (!d.isValid) d = DateTime.fromJSDate(new Date(s));\n  return d.isValid ? d : null;\n};\nconst daysSince = (v) => {\n  const d = toDT(v);\n  return d ? DateTime.now().diff(d, 'days').days : null;\n};\n\nconst cfg = $('Config').first().json;\nconst CADENCE_DAYS = [2, 4, 7];\nconst OPEN_STATUSES = ['new', 'cancelled'];\nconst missedAfter = Number(cfg.missedCheckinDays || 10);\n\nconst leads = $('All Leads').all().map((i) => i.json);\nconst clients = $('All Clients').all().map((i) => i.json);\nconst clientEmails = new Set(clients.map((c) => lc(c.email)).filter(Boolean));\nconst out = [];\n\nfor (const lead of leads) {\n  const email = lc(lead.email);\n  if (!email || clientEmails.has(email)) continue;\n  if (!OPEN_STATUSES.includes(lc(lead.status))) continue;\n  const sent = Number(lead.followups_sent || 0);\n  if (sent >= CADENCE_DAYS.length) continue;\n  const waited = daysSince(lead.last_contact_at || lead.created_at);\n  if (waited === null || waited < CADENCE_DAYS[sent]) continue;\n  out.push({ json: { kind: 'lead', step: sent + 1, lead: { ...lead, email } }, pairedItem: { item: 0 } });\n}\n\nconst missed = clients\n  .filter((c) => lc(c.status) === 'active')\n  .map((c) => {\n    const since = daysSince(c.last_checkin_at);\n    const age = daysSince(c.start_date);\n    const gap = since !== null ? since : age;\n    return { name: c.name || c.email, email: c.email, gap, never: since === null };\n  })\n  .filter((c) => c.gap !== null && c.gap >= missedAfter)\n  .sort((a, b) => b.gap - a.gap);\n\nif (missed.length) {\n  const lines = missed.map((c) => `• ${c.name} - ${c.never ? 'no check-in yet' : 'last check-in'} ${Math.floor(c.gap)} days${c.never ? ' since starting' : ' ago'} (${c.email})`);\n  out.push({\n    json: {\n      kind: 'coach',\n      coach_alert: `⏰ ${missed.length} client${missed.length > 1 ? 's have' : ' has'} gone quiet (${missedAfter}+ days without a check-in):\\n\\n${lines.join('\\n')}\\n\\nA personal message usually works better than another automated email.`,\n    },\n    pairedItem: { item: 0 },\n  });\n}\n\nreturn out;\n"
      },
