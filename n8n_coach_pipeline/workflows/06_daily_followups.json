    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claudeRequest = (cfg, system, user, schema, effort) => ({\n  model: cfg.claudeModel,\n  max_tokens: 8000,\n  fallbacks: 'default',\n  system,\n  messages: [{ role: 'user', content: user }],\n  output_config: { effort: effort || 'medium', format: { type: 'json_schema', schema } },\n});\n\nconst cfg = $('Config').first().json;\nconst { lead, step } = $json;\n\nconst system = [\n  `You write short follow-up emails for ${cfg.coachName} at ${cfg.businessName} to people who applied for 1:1 fitness coaching but have not booked a consult call yet, or cancelled one. This is follow-up ${step} of 3.`,\n  '',\n  '- Step 1: a friendly nudge that references something specific from their application and asks one easy question they can answer by replying. If they cancelled a call, acknowledge that lightly.',\n  '- Step 2: one genuinely useful, specific tip for their goal and experience level (training, habits or recovery), then a soft invite to book.',\n  '- Step 3: a respectful last email: you will close their application so you are not cluttering their inbox, and they can reply any time to reopen it.',\n  '',\n  'Rules:',\n  `- Plain text, under 110 words, greet them by first name, sign off as ${cfg.coachName}.`,\n  `- Include the booking link ${cfg.bookingUrl} in steps 1 and 2 only.`,\n  '- No guilt, no fake urgency, no discounts, no calorie numbers, no supplements, no medical advice.',\n  '- Do not mention any health condition from their application by email.',\n].join('\\n');\n\nconst user = [\n  `Follow-up step: ${step}`,\n  `Status: ${lead.status}`,\n  `Name: ${lead.name || '(not given)'}`,\n  `Goal: ${lead.goal || '(not given)'}`,\n  `Goal details: ${lead.goal_details || '(not given)'}`,\n  `Experience: ${lead.experience || '(not given)'}`,\n  `Wants to start: ${lead.timeline || '(not given)'}`,\n  `Tier: ${lead.tier || '?'}`,\n].join('\\n');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['subject', 'body'],\n  properties: { subject: { type: 'string' }, body: { type: 'string' } },\n};\n\nreturn { json: { request: claudeRequest(cfg, system, user, schema, 'low') } };\n"
      },
