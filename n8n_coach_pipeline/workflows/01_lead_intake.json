      "id": "489caaf1-06e9-4a02-a6c3-1b566604d3a4",
      "name": "Claude: Qualify Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parseClaude = (res) => {\n  if (res.stop_reason === 'refusal') throw new Error('Claude declined this request: ' + JSON.stringify(res.stop_details || {}));\n  if (res.stop_reason === 'max_tokens') throw new Error('Claude ran out of tokens; raise max_tokens in the matching Build node');\n  const block = (res.content || []).find((b) => b.type === 'text');\n  if (!block) throw new Error('Claude returned no text block: ' + JSON.stringify(res).slice(0, 500));\n  return JSON.parse(block.text);\n};\n\nconst lead = $('Normalize Lead').item.json;\nconst ai = parseClaude($json);\nconst flags = ai.health_flags || [];\nconst points = ai.call_talking_points || [];\nconst alertCoach = ai.tier === 'hot' || ai.needs_medical_clearance;\n\nconst headline = ai.tier === 'hot' ? '🔥 Hot lead' : ai.needs_medical_clearance ? '🩺 Lead needs health screening' : '📝 New lead';\nconst coachAlert = [\n  `${headline}: ${lead.name || lead.email} (${ai.fit_score}/100, ${ai.tier})`,\n  `Goal: ${lead.goal}${lead.goal_details ? ' | ' + lead.goal_details : ''}`,\n  `Start: ${lead.timeline || '?'} | Budget: ${lead.budget || '?'} | Days: ${lead.days_per_week || '?'}`,\n  '',\n  ai.summary_for_coach,\n  flags.length ? `\\n⚠️ Health: ${flags.join('; ')}` : '',\n  points.length ? '\\nAsk on the call:\\n' + points.map((p) => `• ${p}`).join('\\n') : '',\n  '',\n  `${lead.email}${lead.phone ? ' | ' + lead.phone : ''}`,\n].join('\\n').replace(/\\n{3,}/g, '\\n\\n');\n\nreturn {\n  json: {\n    ...lead,\n    fit_score: ai.fit_score,\n    tier: ai.tier,\n    goal_category: ai.goal_category,\n    medical_clearance: ai.needs_medical_clearance ? 'required' : 'not flagged',\n    health_flags: flags.join('; '),\n    ai_summary: ai.summary_for_coach,\n    talking_points: points.join(' | '),\n    status: 'new',\n    consult_at: '',\n    followups_sent: 0,\n    last_contact_at: new Date().toISOString(),\n    email_subject: ai.email_subject,\n    email_body: ai.email_body,\n    alert_coach: alertCoach,\n    coach_alert: coachAlert,\n  },\n};\n"
      },
