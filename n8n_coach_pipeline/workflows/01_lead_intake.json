      "id": "b22c79ca-9fbd-4fe6-a136-98fb06ba23dc",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const pick = (o, keys) => {\n  for (const k of keys) {\n    const v = o[k];\n    if (v !== undefined && v !== null && String(v).trim() !== '') return String(v).trim();\n  }\n  return '';\n};\n\nreturn $input.all().map((item, i) => {\n  const fromWebhook = item.json.body && typeof item.json.body === 'object';\n  const src = fromWebhook ? item.json.body : item.json;\n  const email = pick(src, ['email', 'Email']).toLowerCase();\n  if (!email || !email.includes('@')) throw new Error('Lead submission has no valid email address');\n  return {\n    json: {\n      lead_id: 'L-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase(),\n      created_at: new Date().toISOString(),\n      name: pick(src, ['name', 'Full name']),\n      email,\n      phone: pick(src, ['phone', 'Phone']),\n      goal: pick(src, ['goal', 'Main goal']),\n      goal_details: pick(src, ['goal_details', 'details', 'Tell us more about your goal']),\n      experience: pick(src, ['experience', 'Training experience']),\n      days_per_week: pick(src, ['days_per_week', 'Days per week you can train']),\n      timeline: pick(src, ['timeline', 'When do you want to start?']),\n      budget: pick(src, ['budget', 'Monthly coaching budget']),\n      health_notes: pick(src, ['health_notes', 'injuries', 'Injuries, health conditions or medications']),\n      source: pick(src, ['source', 'How did you hear about us?']) || (fromWebhook ? 'website' : 'application form'),\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      },
      "id": "89558373-4444-43e7-a352-f72d04a9fbfb",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claudeRequest = (cfg, system, user, schema, effort) => ({\n  model: cfg.claudeModel,\n  max_tokens: 8000,\n  fallbacks: 'default',\n  system,\n  messages: [{ role: 'user', content: user }],\n  output_config: { effort: effort || 'medium', format: { type: 'json_schema', schema } },\n});\n\nconst cfg = $('Config').first().json;\nconst lead = $json;\n\nconst system = [\n  `You are the intake assistant for ${cfg.businessName}, an online fitness coaching business run by coach ${cfg.coachName}. The main offer is \"${cfg.programName}\" at ${cfg.programPrice} per month.`,\n  '',\n  'For every applicant you do three jobs.',\n  '',\n  '1. Score fit for 1:1 coaching (fit_score 0-100) and assign a tier.',\n  '- hot: ready to start within a month, budget that covers the programme, a clear goal and at least 3 training days.',\n  '- warm: a good fit with one blocker (budget, timing or clarity).',\n  '- cold: just exploring, budget far below the programme, or a goal that belongs with a medical professional rather than a coach.',\n  '',\n  '2. Screen for health issues a coach must know before programming. Set needs_medical_clearance to true when the applicant mentions any of: heart or blood-pressure conditions, chest pain, fainting or dizziness during exercise, diabetes, pregnancy or a recent birth, surgery in the last 12 months, a current injury, an eating disorder now or in the past, or medication that affects heart rate or blood sugar. List each concern as a short phrase in health_flags; leave it empty when nothing is mentioned.',\n  '',\n  `3. Write the first reply email from ${cfg.coachName}.`,\n  '- Plain text, under 150 words, greet them by first name, sign off with the coach name.',\n  '- Mention one specific detail from their application so it clearly is not a template.',\n  `- hot and warm: invite them to book a free consult call at ${cfg.bookingUrl}.`,\n  '- cold: give one genuinely useful tip for their goal and invite them to reply when they are ready. No booking pressure.',\n  '- If needs_medical_clearance is true, add one calm sentence saying the coach will ask a few health questions on the call and may ask them to check with their doctor before starting.',\n  '- Never diagnose, never give medical advice, never promise specific results or timeframes, and never mention calorie or body-fat numbers.',\n  '',\n  'summary_for_coach: two or three sentences a coach can read in ten seconds before a call.',\n  'call_talking_points: three short questions or angles for the consult call.',\n].join('\\n');\n\nconst user = [\n  'New coaching application:',\n  `Name: ${lead.name || '(not given)'}`,\n  `Main goal: ${lead.goal || '(not given)'}`,\n  `Goal details: ${lead.goal_details || '(not given)'}`,\n  `Training experience: ${lead.experience || '(not given)'}`,\n  `Days per week available: ${lead.days_per_week || '(not given)'}`,\n  `Wants to start: ${lead.timeline || '(not given)'}`,\n  `Monthly budget: ${lead.budget || '(not given)'}`,\n  `Injuries, conditions or medications: ${lead.health_notes || 'none mentioned'}`,\n  `Heard about us via: ${lead.source || '(not given)'}`,\n].join('\\n');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['fit_score', 'tier', 'goal_category', 'needs_medical_clearance', 'health_flags', 'summary_for_coach', 'call_talking_points', 'email_subject', 'email_body'],\n  properties: {\n    fit_score: { type: 'integer', description: '0 to 100' },\n    tier: { type: 'string', enum: ['hot', 'warm', 'cold'] },\n    goal_category: { type: 'string', enum: ['fat_loss', 'muscle_gain', 'strength', 'general_fitness', 'performance', 'other'] },\n    needs_medical_clearance: { type: 'boolean' },\n    health_flags: { type: 'array', items: { type: 'string' } },\n    summary_for_coach: { type: 'string' },\n    call_talking_points: { type: 'array', items: { type: 'string' } },\n    email_subject: { type: 'string' },\n    email_body: { type: 'string' },\n  },\n};\n\nreturn { json: { request: claudeRequest(cfg, system, user, schema, 'medium') } };\n"
      },
      "id": "61fcbfad-2f0f-47bf-a0f5-bdac09e123e4",
      "name": "Build Qualify Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
