      "id": "9f15c35d-7d1e-4665-a018-502e99363ef8",
      "name": "Claude: Analyze Check-in",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst parseClaude = (res) => {\n  if (res.stop_reason === 'refusal') throw new Error('Claude declined this request: ' + JSON.stringify(res.stop_details || {}));\n  if (res.stop_reason === 'max_tokens') throw new Error('Claude ran out of tokens; raise max_tokens in the matching Build node');\n  const block = (res.content || []).find((b) => b.type === 'text');\n  if (!block) throw new Error('Claude returned no text block: ' + JSON.stringify(res).slice(0, 500));\n  return JSON.parse(block.text);\n};\n\nconst cfg = $('Config').first().json;\nconst ci = $('Normalize Check-in').first().json;\nconst client = $('Build Analysis Prompt').first().json.client;\nconst ai = parseClaude($input.first().json);\nconst reasons = ai.risk_reasons || [];\nconst autoReply = cfg.autoReplyClients === true || lc(cfg.autoReplyClients) === 'true';\nconst route = !client || ai.needs_coach_now || ai.risk_level === 'red' || !autoReply ? 'coach' : 'auto';\nconst name = (client && client.name) || ci.email;\n\nconst icon = { green: '🟢', amber: '🟠', red: '🔴' }[ai.risk_level] || '⚪';\nconst coachAlert = [\n  client ? `${icon} Check-in needs you: ${name} (${ai.risk_level.toUpperCase()}, adherence ${ai.adherence_score})` : `⚪ Check-in from an email not in Clients: ${ci.email}`,\n  reasons.length ? `Why: ${reasons.join('; ')}` : '',\n  ci.health_changes ? `Health: ${ci.health_changes}` : '',\n  ci.struggles ? `Struggle: ${ci.struggles}` : '',\n  ci.requests ? `Asked for: ${ci.requests}` : '',\n  '',\n  `Trend: ${ai.progress_summary}`,\n  `Adjust: ${ai.coach_notes}`,\n  '',\n  'Draft reply (NOT sent):',\n  `Subject: ${ai.reply_subject}`,\n  ai.reply_body,\n  '',\n  `Reply to: ${ci.email}`,\n].join('\\n').replace(/\\n{3,}/g, '\\n\\n');\n\nreturn [\n  {\n    json: {\n      checkin_id: ci.checkin_id,\n      submitted_at: ci.submitted_at,\n      email: ci.email,\n      name: (client && client.name) || '',\n      weight_kg: ci.weight_kg ?? '',\n      workouts_done: ci.workouts_done ?? '',\n      workouts_planned: ci.workouts_planned ?? '',\n      nutrition: ci.nutrition ?? '',\n      energy: ci.energy ?? '',\n      sleep_hours: ci.sleep_hours ?? '',\n      stress: ci.stress ?? '',\n      wins: ci.wins,\n      struggles: ci.struggles,\n      health_changes: ci.health_changes,\n      requests: ci.requests,\n      adherence_score: ai.adherence_score,\n      risk_level: ai.risk_level,\n      risk_reasons: reasons.join('; '),\n      ai_summary: ai.progress_summary,\n      coach_notes: ai.coach_notes,\n      reply_subject: ai.reply_subject,\n      reply_body: ai.reply_body,\n      reply_mode: route === 'auto' ? 'auto-sent' : 'coach review',\n      client_status: client ? client.status || 'active' : 'unmatched',\n      checkins_count: Number((client && client.checkins_count) || 0) + 1,\n      route,\n      coach_alert: coachAlert,\n    },\n    pairedItem: { item: 0 },\n  },\n];\n"
      },
