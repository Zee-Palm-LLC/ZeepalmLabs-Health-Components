    {
      "parameters": {
        "jsCode": "const num = (v) => {\n  const n = parseFloat(String(v ?? '').replace(',', '.'));\n  return Number.isFinite(n) ? n : null;\n};\nconst text = (v) => String(v ?? '').trim();\n\nreturn $input.all().map((item, i) => {\n  const f = item.json.body && typeof item.json.body === 'object' ? item.json.body : item.json;\n  const email = text(f['Email'] ?? f.email).toLowerCase();\n  if (!email) throw new Error('Check-in has no email address');\n  const done = num(f['Workouts completed this week'] ?? f.workouts_done);\n  const planned = num(f['Workouts planned this week'] ?? f.workouts_planned);\n  return {\n    json: {\n      checkin_id: 'K-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 4).toUpperCase(),\n      submitted_at: new Date().toISOString(),\n      email,\n      weight_kg: num(f['Current weight (kg)'] ?? f.weight_kg),\n      workouts_done: done,\n      workouts_planned: planned,\n      training_completion: done !== null && planned ? Math.round(Math.min(1, done / planned) * 100) : null,\n      nutrition: num(f['Nutrition on plan (1-10)'] ?? f.nutrition),\n      energy: num(f['Energy (1-10)'] ?? f.energy),\n      sleep_hours: num(f['Average sleep (hours)'] ?? f.sleep_hours),\n      stress: num(f['Stress (1-10)'] ?? f.stress),\n      wins: text(f['Biggest win this week'] ?? f.wins),\n      struggles: text(f['Biggest struggle this week'] ?? f.struggles),\n      health_changes: text(f['Any pain, injury or health changes?'] ?? f.health_changes),\n      requests: text(f['Anything you need from me?'] ?? f.requests),\n    },\n    pairedItem: { item: i },\n  };\n});\n"
      },
