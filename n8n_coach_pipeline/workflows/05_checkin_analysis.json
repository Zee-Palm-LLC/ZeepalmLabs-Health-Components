    {
      "parameters": {
        "jsCode": "const lc = (v) => String(v ?? '').trim().toLowerCase();\nconst firstName = (name) => String(name || '').trim().split(/\\s+/)[0] || 'there';\n\nconst claudeRequest = (cfg, system, user, schema, effort) => ({\n  model: cfg.claudeModel,\n  max_tokens: 8000,\n  fallbacks: 'default',\n  system,\n  messages: [{ role: 'user', content: user }],\n  output_config: { effort: effort || 'medium', format: { type: 'json_schema', schema } },\n});\n\nconst cfg = $('Config').first().json;\nconst ci = $('Normalize Check-in').first().json;\nconst client = $('Client Record').all().map((i) => i.json).find((r) => lc(r.email) === ci.email) || null;\nconst history = $input\n  .all()\n  .map((i) => i.json)\n  .filter((r) => lc(r.email) === ci.email)\n  .sort((a, b) => String(a.submitted_at).localeCompare(String(b.submitted_at)))\n  .slice(-6);\n\nconst show = (v, unit) => (v === null || v === undefined || v === '' ? '-' : `${v}${unit || ''}`);\n\nconst system = [\n  `You are the check-in analyst for ${cfg.coachName}, a fitness coach at ${cfg.businessName}. Every week clients submit a short check-in. You read it alongside their recent history, triage it for the coach and draft the coach's reply.`,\n  '',\n  'Triage:',\n  '- adherence_score (0-100): weigh training completion (training_completion is precomputed and is a good anchor), the nutrition score and consistency against previous weeks.',\n  '- risk_level green = on track. amber = slipping: adherence down two weeks running, energy 4 or lower, sleep under 6 hours, stress 8 or higher, or a short disengaged check-in. red = the coach must personally step in.',\n  '- needs_coach_now must be true, with risk_level red, when the client mentions pain, injury, illness, a new medical condition or medication, pregnancy, dizziness or chest symptoms, signs of disordered eating (skipping meals to compensate, guilt about food, extreme restriction), very low mood, or wanting to quit or pause. Also true when they ask something that needs a personal answer from the coach.',\n  '- risk_reasons: short phrases; empty when green.',\n  '- progress_summary: one or two sentences on the trend across weeks, citing the numbers.',\n  '- coach_notes: what the coach should adjust in next week\\'s programme. Practical and specific.',\n  '',\n  'Reply to the client (reply_subject, reply_body):',\n  `- Plain text, under 140 words, greet them by first name, sign off as ${cfg.coachName}.`,\n  '- Acknowledge their specific win, answer their struggle with one concrete adjustment for next week, and end with one clear focus.',\n  '- Never diagnose or give medical advice, never prescribe calories, supplements or medication, and never comment on body shape or appearance.',\n  '- If they mention pain or a health change, tell them to pause anything that aggravates it and that you will message them personally today.',\n  '- When needs_coach_now is true this is a draft the coach will review before sending; write it as the coach should send it.',\n].join('\\n');\n\nconst user = [\n  client\n    ? `Client: ${client.name || ci.email} | plan: ${client.plan || '?'} | goal: ${client.goal || '?'} | started: ${client.start_date || '?'} | medical clearance: ${client.medical_clearance || 'not flagged'}`\n    : `Client: ${ci.email} (not found in the client list)`,\n  '',\n  'This week:',\n  `Weight: ${show(ci.weight_kg, ' kg')}`,\n  `Workouts: ${show(ci.workouts_done)} of ${show(ci.workouts_planned)} (training_completion ${show(ci.training_completion, '%')})`,\n  `Nutrition on plan: ${show(ci.nutrition, '/10')} | Energy: ${show(ci.energy, '/10')} | Sleep: ${show(ci.sleep_hours, ' h')} | Stress: ${show(ci.stress, '/10')}`,\n  `Biggest win: ${ci.wins || '-'}`,\n  `Biggest struggle: ${ci.struggles || '-'}`,\n  `Pain, injury or health changes: ${ci.health_changes || 'none'}`,\n  `Needs from coach: ${ci.requests || 'nothing'}`,\n  '',\n  history.length ? 'Previous check-ins (oldest first):' : 'No previous check-ins - this is their first.',\n  ...history.map(\n    (h) =>\n      `${String(h.submitted_at).slice(0, 10)}: weight ${show(h.weight_kg)}, workouts ${show(h.workouts_done)}/${show(h.workouts_planned)}, nutrition ${show(h.nutrition)}, energy ${show(h.energy)}, sleep ${show(h.sleep_hours)}, stress ${show(h.stress)}, adherence ${show(h.adherence_score)}, risk ${show(h.risk_level)}`,\n  ),\n].join('\\n');\n\nconst schema = {\n  type: 'object',\n  additionalProperties: false,\n  required: ['adherence_score', 'risk_level', 'risk_reasons', 'needs_coach_now', 'progress_summary', 'coach_notes', 'reply_subject', 'reply_body'],\n  properties: {\n    adherence_score: { type: 'integer', description: '0 to 100' },\n    risk_level: { type: 'string', enum: ['green', 'amber', 'red'] },\n    risk_reasons: { type: 'array', items: { type: 'string' } },\n    needs_coach_now: { type: 'boolean' },\n    progress_summary: { type: 'string' },\n    coach_notes: { type: 'string' },\n    reply_subject: { type: 'string' },\n    reply_body: { type: 'string' },\n  },\n};\n\nreturn [{ json: { request: claudeRequest(cfg, system, user, schema, 'medium'), client }, pairedItem: { item: 0 } }];\n"
      },
